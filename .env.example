# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# FRED (Federal Reserve macro data: rates, inflation, labor, growth). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# Optional: a custom OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp,
# relay). Select provider "openai_compatible" and set the base URL; the key is
# optional (local servers need none).
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock (provider "bedrock", install with: pip install ".[bedrock]").
# Auth: either a Bedrock API key (bearer token, no AWS access keys) OR the AWS
# credential chain (env keys / ~/.aws/credentials / IAM role / AWS_PROFILE). Set
# the region either way; a bearer token takes precedence when both are present.
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# ---------------------------------------------------------------------------
# Trade execution (tradingagents/execution/) -- optional, install with:
# pip install ".[exec]" (or docker build --build-arg INSTALL_EXEC_DEPS=1)
# ---------------------------------------------------------------------------
# Paper-first gate: every executor resolves to paper/sandbox mode regardless
# of platform config UNLESS this is exactly "true". Leave unset until you've
# reviewed a real paper-trading track record (see execution/live_gate.py).
#TRADINGAGENTS_LIVE_TRADING_ENABLED=false
#ALPACA_API_KEY=
#ALPACA_SECRET_KEY=
#CCXT_EXCHANGE=binance
#CCXT_API_KEY=
#CCXT_SECRET_KEY=
#EXECUTION_PLATFORM=paper

# Scheduled worker (app/worker.py) -- install with: pip install ".[worker]"
#TRADINGAGENTS_WATCHLIST=AAPL,MSFT,BTC-USD
#TRADINGAGENTS_WORKER_CRON=0 21 * * 1-5
#TRADINGAGENTS_WORKER_CALENDAR=XNYS

# Optional: post completed decisions to an AI-Trader instance (hosted
# ai4trade.ai, or a self-run instance) via REST. Register an agent first
# (POST {base_url}/api/claw/agents/selfRegister) to get agent_token. Both
# unset = disabled (default) -- purely additive, never required.
#TRADINGAGENTS_AI_TRADER_BASE_URL=https://api.ai4trade.ai
#TRADINGAGENTS_AI_TRADER_AGENT_TOKEN=

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
# In the CLI, setting the LLM provider / models / backend URL / language
# also skips the matching interactive selection step (useful for
# OpenAI-compatible endpoints like opencode or LM Studio, and unattended runs).
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
# Per-role provider split: unset means both roles use
# TRADINGAGENTS_LLM_PROVIDER above (unchanged single-provider behavior).
# Set both to route deep-thinking and quick-thinking through different
# providers -- e.g. a cloud provider for deep reasoning, a local Ollama
# endpoint for the high-volume quick-thinking calls.
#TRADINGAGENTS_DEEP_PROVIDER=kimi
#TRADINGAGENTS_DEEP_BASE_URL=
#TRADINGAGENTS_QUICK_PROVIDER=ollama
#TRADINGAGENTS_QUICK_BASE_URL=http://host.docker.internal:11434/v1
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false
# Row caps on agent-controlled date-range tool calls (Phase 3 token
# reduction). Cut by row count (most recent kept), never by string
# truncation. Unset falls back to the defaults below.
#TRADINGAGENTS_MAX_OHLCV_ROWS=250
#TRADINGAGENTS_MAX_INDICATOR_DAYS=90
# Optional per-run ceiling on total tokens (input + output, summed across
# every LLM call). Unset = unlimited. When set and exceeded, the run parks
# via the same path as a provider quota error instead of running unbounded
# -- requires TRADINGAGENTS_CHECKPOINT_ENABLED=true to actually park rather
# than just crash.
#TRADINGAGENTS_TOKEN_BUDGET_PER_RUN=500000
# Sampling temperature (lower = less run-to-run variation on models that
# honor it). Unset leaves each provider at its default. See the README
# "Reproducibility" note — no setting makes LLM output fully deterministic.
#TRADINGAGENTS_TEMPERATURE=0.0
# LLM SDK retry budget forwarded to every provider. Unset leaves each SDK at its
# own default (usually 2). Raise it to ride out bursty 429 rate-limit throttling
# on rate-limited deployments (e.g. Azure OpenAI) instead of aborting the run.
#TRADINGAGENTS_LLM_MAX_RETRIES=6
# Provider-specific reasoning/thinking depth (optional; unset = provider
# default). Setting one also skips the matching interactive prompt.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high

# Master key for at-rest encryption of the browser-saved credentials store
# (config/credentials.json). Any passphrase works (derived with PBKDF2); you
# may also paste a raw 32-byte urlsafe-base64 Fernet key. When set, saved API
# keys are encrypted on disk; when unset the store is written in plaintext
# (legacy behavior). Keep this value secret and stable — losing or changing it
# makes previously encrypted credentials unreadable.
#TRADINGAGENTS_CREDENTIALS_KEY=
